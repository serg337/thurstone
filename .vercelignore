# Local release control state — never deploy
/.toolproof-local/
/.toolproof-local

# Local credentials, provider state, and repository metadata
/.env*
/.git/
/.git
/.github/
/.github
/.vercel/
/.vercel

# Generated, dependency, and test artifacts
/.next/
/.next
/node_modules/
/node_modules
/coverage/
/coverage
/playwright-report/
/playwright-report
/test-results/
/test-results
*.tsbuildinfo
/next-env.d.ts

# Source-only configuration not needed by the production build. Test source remains in the build
# context because the Gate 7 verifier byte-checks its exact adversarial anchors before any external
# state or provider command; Next.js does not include those files in the served runtime bundles.
/playwright.config.ts
/vitest.config.ts
/eslint.config.mjs
/tsconfig.typecheck.json
