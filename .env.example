# Thurstone builds and runs its deterministic interface with every value below absent. Never put
# real values in this file. Hosted values belong only in the deployment provider's server-side
# environment store; Preview receives none of the provider, Redis-write, signing, or activation
# values.
# TOOLPROOF_* remains the evidence-bound compatibility prefix after the Thurstone rename.

# Production-only provider and durable store.
OPENAI_API_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Supported Upstash-native aliases take precedence when present; configure one complete pair only.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Base64url encoding of exactly 32 random bytes.
TOOLPROOF_SIGNING_SECRET=
TOOLPROOF_GUARD_INSTANCE_ID=
TOOLPROOF_GUARD_INITIALIZED_COMMIT=
TOOLPROOF_EXPECTED_VERCEL_PROJECT_ID=
# Exact reviewed source commit; must equal the host-supplied VERCEL_GIT_COMMIT_SHA.
TOOLPROOF_COMMIT_SHA=

# Production-only terminal evidence presentation. These bind the exact deployed commit to the
# permanent Gate 3–6 records. The proof and Git-pack values are Sensitive host variables even
# though they do not authorize provider inference.
TOOLPROOF_GATE3_FROZEN_PROTOCOL_HASH=
TOOLPROOF_REPAIR_PHASE_CALL_OFFSET=
TOOLPROOF_BASELINE_RUN_ID=
TOOLPROOF_BASELINE_EVIDENCE_DIGEST=
TOOLPROOF_GATE5_REVISION_APPROVAL_B64=
TOOLPROOF_GATE5_SOURCE_DIFF_PROOF_B64=
TOOLPROOF_GATE5_REVISION_FREEZE_HASH=
TOOLPROOF_REVISED_RUN_ID=
TOOLPROOF_REVISED_EVIDENCE_DIGEST=
TOOLPROOF_GATE5_PRESENTATION_COMMIT=
TOOLPROOF_GATE6_PRESENTATION_PROOF_B64=
TOOLPROOF_GATE6_PRESENTATION_PROOF_HASH=
# Optional build-only Git-object transport. Omit when the build runs from verified full history.
TOOLPROOF_GATE6_GIT_PACK_B64=

# Signed-out source-fixed judge lane. Keep all values absent except on the exact reviewed
# Production build. The evidence root uses `predecessor` mode with no binding. A proven
# archive-reader recovery, optionally followed by one link-only release hop, uses `successor`
# plus the binding and hash. Production reuses TOOLPROOF_GATE6_GIT_PACK_B64 for the exact shared
# Git-object proof and keeps TOOLPROOF_JUDGE_GIT_PACK_B64 absent.
# TOOLPROOF_JUDGE_LANE_MODE=
# TOOLPROOF_JUDGE_ACTIVE_COMMIT=
# TOOLPROOF_JUDGE_PRESENTATION_MODE=
# TOOLPROOF_JUDGE_PRESENTATION_BINDING_B64=
# TOOLPROOF_JUDGE_PRESENTATION_BINDING_HASH=
# Local/full-history fallback only; this must remain absent in Production.
# TOOLPROOF_JUDGE_GIT_PACK_B64=

# Optional local/test-only overrides. Official Vercel builds use the host-supplied commit and the
# canonical tracked evidence paths. Never set these to bypass hosted build identity.
# TOOLPROOF_EVIDENCE_JSON_PATH=
# TOOLPROOF_EVIDENCE_MARKDOWN_PATH=
# TOOLPROOF_EVIDENCE_ORIGIN=
# TOOLPROOF_FALLBACK_CHROME_PATH=
# TOOLPROOF_BROWSER_FAKE_PROBE=
# TOOLPROOF_BASE_URL=

# Host/integration supplied names—documented here, but never set manually. Vercel supplies
# VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, VERCEL_PROJECT_ID, VERCEL_DEPLOYMENT_ID, and
# VERCEL_URL. The Vercel Upstash integration may additionally inject KV_URL, REDIS_URL, and
# KV_REST_API_READ_ONLY_TOKEN; Thurstone does not consume those three aliases. Its durable boundary
# accepts the Upstash-native pair first, then the KV_REST pair declared above.

# Historical operator-only controls are intentionally absent after their terminal receipts. The
# exact retired names below are documentation, not an invitation to restore them on an ordinary,
# evidence, or release deployment.
# TOOLPROOF_GATE3_SOURCE_BINDING_B64=
# TOOLPROOF_GATE3_SUCCESSOR_LINEAGE_B64=
# TOOLPROOF_GATE3_HUMAN_REVIEW_RECEIPT_B64=
# TOOLPROOF_GATE3_AUTHORING_TERMINATION_B64=
# TOOLPROOF_GATE3_FREEZE_PERSIST_CONFIRMATION=
# TOOLPROOF_GATE5_REVISION_PERSIST_CONFIRMATION=
# TOOLPROOF_REPAIR_OPERATOR_CAPABILITY_HASH=
# TOOLPROOF_SCORED_OPERATOR_CAPABILITY_HASH=
# TOOLPROOF_SCORED_OPERATOR_PHASE=
# TOOLPROOF_SCORED_PHASE_CALL_OFFSET=
# TOOLPROOF_SCORED_PREDECESSOR_PROTOCOL_HASH=
# TOOLPROOF_SCORED_PREDECESSOR_EVIDENCE_DIGEST=
# TOOLPROOF_SCORED_PREDECESSOR_RUN_ID=
# TOOLPROOF_SCORED_PREDECESSOR_DISPOSITION=
# TOOLPROOF_FALLBACK_EXECUTION_CONFIRM=
# TOOLPROOF_PROBE_ACTIVATION_MODE=
# TOOLPROOF_PROBE_ACTIVE_COMMIT=
# TOOLPROOF_PROBE_ACTIVE_POLICY_HASH=
# TOOLPROOF_PROBE_ACTIVE_SCRIPT_HASH=
# TOOLPROOF_PROBE_ACTIVE_RUNNER_HASH=
# TOOLPROOF_PROBE_ACTIVE_CONTINUATION_HASH=
# TOOLPROOF_PROBE_POLICY_MIGRATION_RECEIPT_HASH=
# TOOLPROOF_PROBE_ACTIVATION_SECRET=
# TOOLPROOF_PROBE_ACTIVATION_HASH=
# TOOLPROOF_PROBE_OPERATOR_CAPABILITY_HASH=
# TOOLPROOF_PROBE_APPROVED_COMMIT=
# TOOLPROOF_PROBE_INIT_CONFIRM=
# TOOLPROOF_PROBE_REAP_CONFIRM=
# TOOLPROOF_PROBE_REAP_DIGEST=
# TOOLPROOF_PROBE_REAP_JTI=
# TOOLPROOF_PROBE_POLICY_MIGRATION_CONFIRM=
# TOOLPROOF_PROBE_POLICY_V03_MIGRATION_PREFLIGHT=
# TOOLPROOF_PROBE_POLICY_V03_MIGRATION_CONFIRM=
# TOOLPROOF_PROBE_POLICY_V04_MIGRATION_PREFLIGHT=
# TOOLPROOF_PROBE_POLICY_V04_MIGRATION_CONFIRM=
# TOOLPROOF_PROBE_POLICY_V05_MIGRATION_PREFLIGHT=
# TOOLPROOF_PROBE_POLICY_V05_MIGRATION_CONFIRM=

# The challenge-lifetime USD $10 / 160-call policy is frozen in source and is intentionally not
# overridable through deployment variables.
