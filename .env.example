# Server-side provider configuration. Values belong in the host secret store.
OPENAI_API_KEY=
# Base64url encoding of exactly 32 random bytes; Production only.
TOOLPROOF_SIGNING_SECRET=
TOOLPROOF_GUARD_INSTANCE_ID=
TOOLPROOF_GUARD_INITIALIZED_COMMIT=
# Production-only expected deployment identity; must equal the host-supplied project ID.
TOOLPROOF_EXPECTED_VERCEL_PROJECT_ID=

# The challenge-lifetime USD $10 / 160-call policy is frozen in source and is
# intentionally not overridable through deployment variables.

# Durable replay/rate/spend state for the hosted Probe lane.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Release identity populated by deployment automation, never by the browser.
TOOLPROOF_COMMIT_SHA=
