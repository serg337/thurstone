# Server-side provider configuration. Values belong in the host secret store.
OPENAI_API_KEY=
# Base64url encoding of exactly 32 random bytes; Production only.
TOOLPROOF_SIGNING_SECRET=
TOOLPROOF_GUARD_INSTANCE_ID=
TOOLPROOF_GUARD_INITIALIZED_COMMIT=
# Production-only expected deployment identity; must equal the host-supplied project ID.
TOOLPROOF_EXPECTED_VERCEL_PROJECT_ID=

# Gate-specific activation is deliberately absent by default. These Production-only values must
# all bind the same reviewed deployment before the four-case calibration route can become active.
# TOOLPROOF_PROBE_ACTIVATION_MODE=calibration
# TOOLPROOF_PROBE_ACTIVE_COMMIT=
# TOOLPROOF_PROBE_ACTIVE_POLICY_HASH=
# TOOLPROOF_PROBE_ACTIVE_SCRIPT_HASH=
# TOOLPROOF_PROBE_ACTIVE_RUNNER_HASH=
# TOOLPROOF_PROBE_ACTIVE_CONTINUATION_HASH=
# Hash of the durable, server-verified policy-migration receipt required by activation v2.
# TOOLPROOF_PROBE_POLICY_MIGRATION_RECEIPT_HASH=
# Base64url encoding of a separate, exact 32 random bytes (never reuse the signing secret).
# TOOLPROOF_PROBE_ACTIVATION_SECRET=
# HMAC receipt computed from the frozen activation manifest and activation secret.
# TOOLPROOF_PROBE_ACTIVATION_HASH=

# One-time Production migration operator inputs. Keep absent during ordinary builds/runtime.
# The receipt is canonical JSON encoded as base64url and contains private live-call identities.
# TOOLPROOF_PROBE_POLICY_MIGRATION_RECEIPT=
# TOOLPROOF_PROBE_POLICY_MIGRATION_CONFIRM=
# TOOLPROOF_PROBE_APPROVED_COMMIT=

# The challenge-lifetime USD $10 / 160-call policy is frozen in source and is
# intentionally not overridable through deployment variables.

# Durable replay/rate/spend state for the hosted Probe lane.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Release identity populated by deployment automation, never by the browser.
TOOLPROOF_COMMIT_SHA=
