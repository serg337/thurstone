{
  "name": "toolproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unit tests for meaning in WebMCP tool behavior.",
  "license": "MIT",
  "author": "Sergio Valencia",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "durable-store:check": "node scripts/check-durable-store.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "install:check": "node scripts/verify-install.mjs",
    "lint": "eslint . --max-warnings=0",
    "prebuild": "node scripts/clean-next-dev-types.mjs",
    "probe-controls:hashes": "tsx --tsconfig tsconfig.operator.json scripts/probe-controls.ts hashes",
    "probe-controls:init": "tsx --tsconfig tsconfig.operator.json scripts/probe-controls.ts init",
    "probe-controls:bootstrap": "tsx --tsconfig tsconfig.operator.json scripts/probe-controls.ts bootstrap",
    "probe-controls:integration": "tsx --tsconfig tsconfig.operator.json scripts/probe-controls.ts integration-test",
    "probe-controls:migrate": "tsx --tsconfig tsconfig.operator.json scripts/probe-controls.ts migrate-policy",
    "probe-continuation:integration": "tsx --tsconfig tsconfig.operator.json scripts/probe-continuation-integration.ts",
    "probe-controls:reap": "tsx --tsconfig tsconfig.operator.json scripts/probe-controls.ts reap",
    "probe-controls:status": "tsx --tsconfig tsconfig.operator.json scripts/probe-controls.ts status",
    "provider:check": "node scripts/check-openai-entitlement.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:safe": "playwright test --grep-invert @native --grep-invert @model",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "vercel-build": "npm run durable-store:check && npm run probe-controls:integration && npm run probe-continuation:integration && npm run probe-controls:bootstrap && npm run provider:check && npm run build && npm run verify:probe-no-leakage",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "verify:probe-no-leakage": "node scripts/verify-probe-no-leakage.mjs",
    "verify:publication": "node scripts/verify-publication.mjs"
  },
  "dependencies": {
    "@upstash/redis": "1.38.3",
    "json-canonicalize": "3.0.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "webmcp-types": "0.1.5"
  }
}
