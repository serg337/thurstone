# Private/local release control records — never publish
/.toolproof-local/

# Dependencies and package-manager state
/node_modules/
/.npm/

# Framework and build output
/.next/
/next-env.d.ts
/out/
/dist/
/coverage/
/.turbo/
*.tsbuildinfo

# Browser and test output
/playwright-report/
/test-results/
/blob-report/

# Deployment-local state
/.vercel/

# Secrets and local environment files
/.env
/.env.*
!/.env.example
*.pem
*.key

# Editor and operating-system files
.DS_Store
*.swp
